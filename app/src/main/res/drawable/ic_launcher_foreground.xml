<?xml version="1.0" encoding="utf-8"?>
<!--
    Figura del ícono: un peso encerrado, y debajo una flecha hacia abajo.
    Lee como "de este monto sale este otro, más chico": nominal → líquido.

    Todo el dibujo cae dentro de x∈[30,78] e y∈[26,83], holgadamente adentro de
    la zona segura de 72 dp (18..90), así ningún recorte se come una punta.

    Es blanco puro y de trazo parejo a propósito: este mismo archivo hace de
    capa `monochrome` para los íconos temáticos de Android 13+, donde el sistema
    descarta el color y se queda solo con la silueta. Un relleno de dos tonos se
    vería como una mancha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Recuadro que contiene al peso. -->
    <path
        android:pathData="M36,26h36a7,7 0,0 1,7 7v20a7,7 0,0 1,-7 7h-36a7,7 0,0 1,-7 -7v-20a7,7 0,0 1,7 -7z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- El signo $, dibujado como una S trazada más una barra vertical. -->
    <group
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="44.16"
        android:translateY="31.16">
        <path
            android:pathData="M17,7.5C17,5.3 14.8,4 12,4C9.2,4 7,5.6 7,8C7,10.4 9.2,11.6 12,12C14.8,12.4 17,13.6 17,16C17,18.4 14.8,20 12,20C9.2,20 7,18.7 7,16.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
        <path
            android:pathData="M12,1.5L12,22.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
    </group>

    <!-- Flecha hacia abajo: el descuento. El asta llega hasta el vértice de la
         punta, no hasta donde empieza: si se corta antes, entre el extremo
         redondeado del asta y las dos ramas de la V queda una muesca del color
         del fondo. -->
    <path
        android:pathData="M54,62L54,81"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,71L54,81L63,71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
