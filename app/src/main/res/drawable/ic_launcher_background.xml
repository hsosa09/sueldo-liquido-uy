<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del ícono adaptativo: un color plano.

    Los 108 dp del lienzo son deliberados: el sistema recorta el ícono con la
    forma que elija el lanzador (círculo, cuadrado redondeado, squircle) y solo
    garantiza los 72 dp centrales. Por eso el fondo es liso de borde a borde y
    todo el dibujo vive en ic_launcher_foreground.xml, dentro de esa zona segura.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0F766E"
        android:pathData="M0,0h108v108h-108z" />
</vector>
